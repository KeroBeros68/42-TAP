# Settings of the project (copy this file to .env and change what you need).
# A variable that is already set in the shell wins over this file.

# TCP port of the server, and the one the clients connect to (1 to 65535).
SERVER_PORT=8080

# Address of the server, for the clients.
SERVER_IP=127.0.0.1

# Lowest level of the logs of the server: debug, info, warn or error.
LOG_LEVEL=debug

# File where the logs of the server are also written, at its end (empty: no file).
LOG_FILE=server.log

# Limits against abuse (the defaults are in server/defines.hpp). A value that is not a number or is out of its bounds is ignored (with a warning in the logs).
# 0 turns off the limit of commands, clients and connections (never the limit of bytes).
# The limits per address also apply to 127.0.0.1: raise MAX_SESSIONS_PER_IP when testing with many local clients.
MAX_OUT_BUFFER=65536          # bytes waiting to be sent to a client before he is disconnected
MAX_READ_PER_TURN=16384       # bytes read from a client in one turn of the loop
COMMAND_WINDOW_MS=1000        # length of the window in which the commands of a client are counted
MAX_COMMANDS_PER_WINDOW=20    # commands accepted from a client in one window
MAX_FLOOD_WINDOWS=3           # windows in a row over the limit before the client is disconnected
MAX_SESSIONS=64               # clients connected at the same time
MAX_SESSIONS_PER_IP=5         # clients connected at the same time from one address
CONNECT_WINDOW_MS=10000       # length of the window in which the connections of an address are counted
MAX_CONNECTS_PER_WINDOW=10    # connections accepted from one address in one window
