# Settings of the project (copy this file to .env and change what you need).
# A variable that is already set in the shell wins over this file.

# TCP port of the server, and the one the clients connect to (1 to 65535).
SERVER_PORT=8080

# Address of the server, for the clients.
SERVER_IP=127.0.0.1

# Lowest level of the logs of the server: debug, info, warn or error.
LOG_LEVEL=info

# File where the logs of the server are also written, at its end (empty: no file).
LOG_FILE=
