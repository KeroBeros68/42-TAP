# Valgrind suppressions for the 42 TAP GUI.
#
# Every still-reachable block reported for clients/gui/42TAP originates inside a
# system library, never in our code: our binary appears in those stacks only as
# `main`, the outer caller of QApplication::exec(). X11, GLib, fontconfig, D-Bus
# and Qt all keep deliberately-live global state (connection handles, type
# registries, caches) and expose no way to free it, so there is nothing for us
# to delete.
#
# One stanza per library. `...` matches zero or more stack frames, and frames
# are matched from the innermost (malloc) outward, so each pattern reads
# "this library is somewhere on the allocation stack".
#
# `match-leak-kinds: reachable` is load-bearing -- it limits every stanza to
# blocks a live pointer still owns. Our own leaks are `definitely lost`, which
# no stanza here matches. Removing that line would turn this file into a
# blanket that hides real bugs.
#
# Usage:
#   QT_XCB_GL_INTEGRATION=none valgrind --leak-check=full \
#       --suppressions=clients/gui/ignore_library.supp ./clients/gui/42TAP
#
# Note: a `possibly lost` block for the QDBus accessibility thread's TLS
# (pthread_create > QThread::start > QDBusConnection::sessionBus) appears in
# roughly one run in four depending on thread teardown timing. It is library
# noise, but it does count as an error, so --error-exitcode=1 can flake.

{
   x11_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   obj:*/libX11.so*
   ...
}
{
   qt_xcb_qpa_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   obj:*/libQt5XcbQpa.so*
   ...
}
{
   xcb_platform_plugin_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   obj:*/plugins/platforms/libqxcb.so
   ...
}
{
   glib_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   obj:*/libglib-2.0.so*
   ...
}
{
   dbus_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   obj:*/libdbus-1.so*
   ...
}
{
   fontconfig_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   obj:*/libfontconfig.so*
   ...
}
{
   expat_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   obj:*/libexpat.so*
   ...
}
{
   icu_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   obj:*/libicuuc.so*
   ...
}
{
   qt_core_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   obj:*/libQt5Core.so*
   ...
}
{
   qt_gui_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   obj:*/libQt5Gui.so*
   ...
}
{
   qt_widgets_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   obj:*/libQt5Widgets.so*
   ...
}
{
   qt_dbus_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   obj:*/libQt5DBus.so*
   ...
}
{
   dynamic_loader_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   obj:*/ld-linux-x86-64.so*
   ...
}
